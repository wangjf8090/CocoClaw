# SelfClaw Environment Configuration
# Copy this file to .env and update values accordingly

# System Configuration
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=info

# Gateway Configuration
GATEWAY_PORT=8080
GATEWAY_SECURE_PORT=8443
WEBSOCKET_PORT=9000
MAX_CONNECTIONS=10000
HEARTBEAT_INTERVAL=30000

# Query Engine Configuration
QUERY_ENGINE_PORT=8081
MAX_STREAMING_SESSIONS=1000
STREAMING_TIMEOUT=300000
TOKEN_BUFFER_SIZE=4096

# Memory System Configuration
MEMORY_DB_HOST=postgres
MEMORY_DB_PORT=5432
MEMORY_DB_NAME=selfclaw_memory
MEMORY_DB_USER=selfclaw
MEMORY_DB_PASSWORD=change_me_in_production
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_in_production

# Permission System
JWT_SECRET=change_me_in_production_jwt_secret_key
PERMISSION_CACHE_TTL=300
RBAC_ENABLED=true

# Self-Evolution Harness
HARNESS_ENABLED=true
EVOLUTION_INTERVAL=3600000
MAX_EVOLUTION_STEPS=100
AUTO_PROMOTE_THRESHOLD=0.85
SAFETY_BOUNDARY_ENABLED=true

# SOUL Personality Module
SOUL_ENABLED=true
PERSONALITY_PROFILES_PATH=/config/personalities
EMOTION_DECAY_RATE=0.1
MEMORY_RETENTION_FACTOR=0.7

# Database Configuration
POSTGRES_USER=selfclaw
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=selfclaw

# API Configuration
API_RATE_LIMIT=1000
API_RATE_LIMIT_WINDOW=60000
CORS_ORIGINS=*

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
ENABLE_TRACING=true
